<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:BooksDb.Android"
             x:Class="BooksDb.Android.GalleryView"
             x:DataType="vm:GalleryViewModel">
    <Grid>
        <Grid RowDefinitions="Auto,*,Auto" Margin="12,8,12,8">
            <StackPanel Grid.Row="0" Margin="4,0,4,8">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="Bold"/>
                <TextBlock Text="{Binding CountText}" Foreground="Gray" FontSize="13"/>
            </StackPanel>

            <ScrollViewer x:Name="ThumbScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          SizeChanged="OnThumbSizeChanged">
                <ScrollViewer.GestureRecognizers>
                    <PinchGestureRecognizer/>
                </ScrollViewer.GestureRecognizers>
                <ItemsControl x:Name="ThumbItems" ItemsSource="{Binding Photos}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:GalleryPhoto">
                            <Border Width="{Binding ((vm:GalleryViewModel)DataContext).TileWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Height="{Binding ((vm:GalleryViewModel)DataContext).TileHeight, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    Margin="4" CornerRadius="4"
                                    Background="#22808080" ClipToBounds="True"
                                    PointerPressed="OnTilePointerPressed" PointerReleased="OnTilePointerReleased"
                                    Tapped="OnTileTapped">
                                <Panel>
                                    <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                    <Border IsVisible="{Binding ShowCircle}"
                                            Width="30" Height="30" CornerRadius="15"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="6"
                                            BorderBrush="White" BorderThickness="2"
                                            Background="#66000000"
                                            Tapped="OnCircleTapped">
                                        <TextBlock Text="✓" Foreground="White" FontSize="17" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   IsVisible="{Binding IsSelected}"/>
                                    </Border>
                                </Panel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Row="2" IsVisible="{Binding SelectionMode}"
                    Background="#22808080" CornerRadius="6" Padding="12,8" Margin="0,8,0,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="{Binding SelectionText}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Delete" Foreground="#E53935"
                            IsEnabled="{Binding HasSelection}" Click="OnDeleteSelected"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Fullscreen preview overlay (edge-to-edge; pinch to zoom, one-finger drag to pan, tap to dismiss) -->
        <Border x:Name="FsOverlay" IsVisible="{Binding IsFullscreen}" Background="Black"
                Tapped="OnFullscreenTapped"
                PointerPressed="OnFsPointerPressed"
                PointerMoved="OnFsPointerMoved"
                PointerReleased="OnFsPointerReleased"
                PointerCaptureLost="OnFsPointerCaptureLost">
            <Border.GestureRecognizers>
                <PinchGestureRecognizer/>
            </Border.GestureRecognizers>
            <Panel>
                <Image x:Name="FsImage" Source="{Binding FullImage}" Stretch="Uniform"/>
                <!-- Mark this photo for selection; carries over to the grid's selection mode. Hidden while zoomed. -->
                <Border x:Name="FsCheck" IsVisible="{Binding FullscreenCheckVisible}"
                        Width="54" Height="54" CornerRadius="27"
                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,40"
                        Background="#88000000" BorderBrush="White" BorderThickness="2"
                        Tapped="OnFsCheckTapped">
                    <TextBlock Text="✓" Foreground="White" FontSize="28" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Fullscreen.IsSelected}"/>
                </Border>
            </Panel>
        </Border>
    </Grid>
</UserControl>
