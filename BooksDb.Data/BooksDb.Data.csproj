<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Dapper" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <!-- Pin the native SQLite bundle to the 3.0 line (SQLite 3.50.3) to clear
         CVE-2025-6965; overrides the 2.1.11 pulled transitively by MDS. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="booksdb_schema.sql" />
    <EmbeddedResource Include="migration_002_pending_captures.sql" />
  </ItemGroup>

</Project>