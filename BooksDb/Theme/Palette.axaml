<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Raw colors (single source of truth) -->
    <Color x:Key="ColorAppBackground">#191A1C</Color>
    <Color x:Key="ColorSurfaceStage">#1E1E1E</Color>
    <Color x:Key="ColorBorderSubtle">#3A3A3A</Color>
    <Color x:Key="ColorSplitter">#3A3D40</Color>
    <Color x:Key="ColorBadgeDanger">#E53935</Color>
    <Color x:Key="ColorBadgeWarn">#FB8C00</Color>
    <Color x:Key="ColorScrim">#CC000000</Color>
    <Color x:Key="ColorStar">#FFD700</Color>
    <Color x:Key="ColorOnAccent">#FFFFFF</Color>

    <!-- Brushes (reference these from views) -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorAppBackground}"/>
    <SolidColorBrush x:Key="SurfaceStageBrush"  Color="{StaticResource ColorSurfaceStage}"/>
    <SolidColorBrush x:Key="BorderSubtleBrush"  Color="{StaticResource ColorBorderSubtle}"/>
    <SolidColorBrush x:Key="SplitterBrush"      Color="{StaticResource ColorSplitter}"/>
    <SolidColorBrush x:Key="BadgeDangerBrush"   Color="{StaticResource ColorBadgeDanger}"/>
    <SolidColorBrush x:Key="BadgeWarnBrush"     Color="{StaticResource ColorBadgeWarn}"/>
    <SolidColorBrush x:Key="ScrimBrush"         Color="{StaticResource ColorScrim}"/>
    <SolidColorBrush x:Key="StarBrush"          Color="{StaticResource ColorStar}"/>
    <SolidColorBrush x:Key="OnAccentBrush"      Color="{StaticResource ColorOnAccent}"/>
</ResourceDictionary>