<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="using:BooksDb.Data.Models"
             x:Class="BooksDb.Views.CoverTile"
             x:CompileBindings="True" x:DataType="models:BookListItem">
    <Border Width="124" Height="186" Margin="6"
            CornerRadius="3" ClipToBounds="True"
            BoxShadow="0 1 4 0 #40000000">
        <Panel>
            <!-- genre placeholder (behind); background set in code-behind -->
            <Border x:Name="PlaceholderHost" CornerRadius="3">
                <Panel Margin="10">
                    <PathIcon Data="{StaticResource Icon.Book}" Width="60" Height="60"
                              Foreground="White" Opacity="0.12"
                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <Grid RowDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Text="{Binding Title}"
                                   Foreground="White" FontSize="11" FontWeight="SemiBold"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxLines="4" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Row="2" Text="{Binding Authors}"
                                   Foreground="White" Opacity="0.9" FontSize="9"
                                   TextWrapping="Wrap" TextAlignment="Center"
                                   MaxLines="2" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                </Panel>
            </Border>

            <!-- real cover (in front; shown once the bitmap is ready) -->
            <Image x:Name="CoverImage" Stretch="UniformToFill" IsVisible="False"/>

            <!-- selection ring (topmost), toggled from code-behind -->
            <Border x:Name="SelectionRing" IsVisible="False"
                    CornerRadius="3" BorderThickness="3">
                <Border.BorderBrush>
                    <SolidColorBrush Color="{DynamicResource SystemAccentColor}"/>
                </Border.BorderBrush>
            </Border>
        </Panel>
    </Border>
</UserControl>
