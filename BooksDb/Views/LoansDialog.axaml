<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:BooksDb.Data.Models"
        x:Class="BooksDb.Views.LoansDialog"
        Title="Loans"
        Width="600" Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16" RowDefinitions="Auto,Auto,*,Auto">
        <TextBlock x:Name="HeaderText" Grid.Row="0" Classes="dialogTitle"/>

        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
            <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center" FontWeight="Bold"/>
            <Button x:Name="ActionButton" Grid.Column="1" Classes="accent" Click="OnAction"/>
        </Grid>

        <Grid Grid.Row="2">
            <DataGrid x:Name="HistoryGrid"
                      x:DataType="models:LoanHistoryItem"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Borrower" Binding="{Binding Borrower}"        Width="*"/>
                    <DataGridTextColumn Header="Lent"     Binding="{Binding DateLent}"        Width="Auto"/>
                    <DataGridTextColumn Header="Returned" Binding="{Binding ReturnedDisplay}" Width="Auto"/>
                    <DataGridTextColumn Header="Notes"    Binding="{Binding Notes}"           Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No loans recorded for this book yet."
                       IsVisible="False" Opacity="0.7"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <Button Grid.Row="3" Content="Close" Click="OnClose"
                HorizontalAlignment="Right" Margin="0,12,0,0" IsCancel="True" IsDefault="True"/>
    </Grid>
</Window>