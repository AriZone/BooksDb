<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="using:BooksDb.Data.Models"
        x:Class="BooksDb.Views.CapturesDialog"
        Title="Pending captures"
        Width="640" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppBackgroundBrush}">
    <Grid Margin="16" RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0" Classes="dialogTitle" Text="Pending captures"/>

        <Grid Grid.Row="1">
            <DataGrid x:Name="CapturesGrid"
                      x:DataType="models:PendingCapture"
                      AutoGenerateColumns="False" IsReadOnly="True"
                      GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ISBN-13"  Binding="{Binding Isbn13}"       Width="*"/>
                    <DataGridTextColumn Header="Shelf"    Binding="{Binding Shelf}"        Width="Auto"/>
                    <DataGridTextColumn Header="Photos"   Binding="{Binding Photos.Count}" Width="Auto"/>
                    <DataGridTextColumn Header="Received" Binding="{Binding ReceivedAt}"   Width="2*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock x:Name="EmptyText" Text="No pending captures."
                       IsVisible="False" Opacity="0.7"
                       VerticalAlignment="Center" HorizontalAlignment="Center"/>
        </Grid>

        <StackPanel Grid.Row="2" Classes="dialogButtons">
            <Button Content="Open"    Click="OnOpen"/>
            <Button Content="Discard" Click="OnDiscard"/>
            <Button Content="Refresh" Click="OnRefresh"/>
            <Button Content="Close"   Click="OnClose" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>